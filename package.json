{
  "name": "bastion-gate",
  "version": "1.0.0",
  "description": "Multi-agent parallel development & hard-gate CLI for AI coding agents. DAG waves, worktree isolation, red-first lock, baseline CI gate.",
  "author": "mmxz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maomuxz/bastion-gate.git"
  },
  "homepage": "https://github.com/maomuxz/bastion-gate#readme",
  "bugs": {
    "url": "https://github.com/maomuxz/bastion-gate/issues"
  },
  "type": "module",
  "bin": {
    "bastion": "./dist/cli.js",
    "bastion-gate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test dist-test/tests/*.test.js",
    "demo": "npm run build:test && node dist-test/demo/run-demo.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "swarm",
    "worktree",
    "testing",
    "tdd",
    "ci",
    "gate",
    "claude-code",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
